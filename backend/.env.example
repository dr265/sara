[TEMPLATE]
# Copy to backend/.env and fill only the integrations you use.
SARA_DB_URL=sqlite:///./sara.db
SARA_API_KEY=replace-with-a-random-api-key
FULLAI_API_TOKEN=replace-with-a-random-desktop-token
SARA_MASTER_KEY=replace-with-a-stable-secret

LLM_BASE_URL=https://api.xkiro.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash
# Google Gemini (native generateContent API) — used first when configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional secondary provider for automatic failover (app/core/llm_router.py)
ANYMODEL_API_KEY=
ANYMODEL_BASE_URL=https://anymodel.org/v1
ANYMODEL_MODEL=
# Optional additional providers picked up automatically when set
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# PUBLIC_BASE_URL must be a public HTTPS URL (ngrok/cloudflared) so Twilio can
# reach the voice-agent webhooks and fetch the generated speech audio.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Voice agent speech: VOICE_TTS_PROVIDER=elevenlabs|sarvam, VOICE_STT_PROVIDER=sarvam
VOICE_TTS_PROVIDER=
VOICE_STT_PROVIDER=
# Sarvam voice overrides — bulbul:v2 / saaras:v2.5 / anushka are deprecated.
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_LANGUAGE=en-IN
# Optional Sarvam tuning (defaults shown)
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TIMEOUT=60
SARVAM_MAX_RETRIES=2
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_SAMPLE_RATE=22050

# ============ VOICE BOOKING AGENT (hotel/appointment flow) ============
# Demo hotel dataset file (auto-created with rooms/inventory on first run)
# VOICE_DEMO_HOTEL_FILE=voice_demo_hotel.json
# Demo receptionist fallback when no persona number is set
VOICE_DEMO_RECEPTIONIST_NUMBER=+919000000001
# Max call duration in seconds before the agent wraps up politely
VOICE_MAX_CALL_SECONDS=900
# Voice agent log verbosity for the sara.voice.* loggers (INFO recommended)
VOICE_LOG_LEVEL=INFO
# VOICE_LOG_JSON=1 emits JSON lines instead of plain text
TELEGRAM_BOT_TOKEN=
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1
ZERNIO_ACCOUNT_ID=
UNIPILE_DSN=
UNIPILE_ACCESS_TOKEN=
UNIPILE_ACCOUNT_ID=

# --- Twilio voice calling ---
# Credentials live in backend/.env only — never commit real values here.
# All four are required for inbound/outbound voice calls to work.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional API key pair (used instead of the auth token when both are set)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# E.164 format, e.g. +15551234567 (the number SARA speaks from / answers on)
TWILIO_PHONE_NUMBER=
# Public HTTPS tunnel Twilio can reach (ngrok/cloudflared). This drives the
# Media Streams wss:// URL, so it MUST be wss-capable. Leave blank to fall
# back to the half-duplex TwiML <Gather> loop.
TWILIO_WEBHOOK_BASE_URL=
# Route Twilio's callbacks to the voice agent instead of Twilio's demo greeting.
# Set to 1 to let the backend re-publish the number's voice URL at boot.
TWILIO_AUTO_SYNC_VOICE_URL=1
# Full-duplex Media Streams. KEEP 0 ON TRIAL ACCOUNTS: <Connect><Stream> cannot
# satisfy Twilio's "press any key to execute the code" trial gate, so the caller
# hears only that prompt and then silence. The default TwiML <Say>/<Gather> loop
# answers instantly and works on trial. Set to 1 after upgrading the account.
TWILIO_MEDIA_STREAMS=0
ELEVENLABS_API_KEY=
SARVAM_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_SENDER=
GMAIL_APP_PASSWORD=

# ============ KAPSO WHATSAPP GATEWAY (https://app.kapso.ai) ============
# Project API key: Kapso dashboard -> Integrations -> API keys
KAPSO_API_KEY=
# Phone number id of your Kapso-connected number (Phone numbers page)
KAPSO_PHONE_NUMBER_ID=
# Any secret you choose — paste the SAME value when creating the webhook in
# the Kapso dashboard; deliveries are signed with X-Webhook-Signature (HMAC-SHA256).
KAPSO_WEBHOOK_SECRET=

# ============ EMAIL AUTOMATION AGENT (/email-agent/*) ============
# Sending reuses GMAIL_SENDER + GMAIL_APP_PASSWORD (same SMTP system as the
# voice agent), or set the generic SMTP_* override for any other provider.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
EMAIL_AGENT_FROM=
# Rate limiting / retries for campaigns (sane defaults if omitted)
EMAIL_AGENT_RATE_DELAY=2.0
EMAIL_AGENT_MAX_RETRIES=3
EMAIL_AGENT_SEND_TIMEOUT=30
EMAIL_AGENT_USE_LLM=true
# Google Sheets ingestion - service account (recommended). Paste the entire
# downloaded key JSON as a single line, or point GOOGLE_CREDENTIALS_FILE at the key file.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_FILE=
# Share the Sheet with the service-account e-mail (xxx@yyy.iam.gserviceaccount.com).

# --- Voice Calling Agent: booking + languages ---
# Receptionist transfer destination for the voice booking agent (E.164).
VOICE_RECEPTIONIST_NUMBER=+919000000000
# Demo hotel dataset file (auto-created with real inventory on first use).
#VOICE_DEMO_HOTEL_FILE=voice_demo_hotel.json
# Default voice language for the agent (English primary; callers are
# auto-detected per turn and can switch any time).
# Supports: en-IN hi-IN ta-IN te-IN bn-IN mr-IN gu-IN kn-IN ml-IN pa-IN od-IN as-IN ur-IN
VOICE_AGENT_LANGUAGE=en-IN
