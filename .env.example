# sara-ai-platform - root environment template
#
# Copy the relevant entries into backend/.env (the backend only reads that
# file, loaded by backend/run_backend.py). Every variable below is referenced
# by real code - see the file/line notes per section. Placeholder values are
# intentionally EMPTY: fill them in locally, never commit real secrets.

# --- Server -----------------------------------------------------------------
# backend/run_backend.py: uvicorn port override (default 8000)
SARA_PORT=8000
# app/core/config.py: base URL used to build Twilio webhook URLs
# (app/api/voice_agent.py); e.g. https://your-tunnel.ngrok-free.dev
PUBLIC_BASE_URL=
# app/api/deps.py: shared API key required by X-API-Key / Bearer on most
# /api routes (frontend sends NEXT_PUBLIC_SARA_API_KEY)
SARA_API_KEY=
# app/services/whatsapp_channels.py + core/telegram_host.py: master secret
# the Fernet channel-credential key is derived from (set once, keep stable -
# changing it makes stored channel credentials undecryptable)
SARA_MASTER_KEY=
WEBHOOK_SECRET=

# --- LLM failover chain (core/llm_router.py) --------------------------------
# Primary OpenAI-compatible provider, then the failover presets below.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
VOICE_LLM_MODEL=
LLM_QUOTA_TTL_S=
# Provider-specific keys/presets (all optional; only what you use is needed)
XKIRO_API_KEY=
CODECRAFT_API_KEY=
HASHNEURON_API_KEY=
SELORA_API_KEY=
APINEX_API_KEY=
CLEANAPIS_API_KEY=
ANYMODEL_API_KEY=
MANIFEST_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- WhatsApp / Meta --------------------------------------------------------
# app/api/legacy.py: Meta webhook verify token (no insecure default anymore -
# the backend refuses to verify webhooks until you set this)
WHATSAPP_VERIFY_TOKEN=
# app/api/legacy.py: Meta Cloud API credentials
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# --- Voice / telephony (app/core/config.py, services/*) ---------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ELEVENLABS_API_KEY=
SARVAM_API_KEY=

# --- Email automation (agents/email_automation.py) ---------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
GMAIL_APP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- WhatsApp transport providers (agents/whatsapp_*) ------------------------
UNIPILE_DSN=
UNIPILE_API_KEY=
ZERNIO_API_KEY=
KAPSO_API_KEY=

# --- Agent workspace ----------------------------------------------------------
# core/memory_manager.py: root dir for per-agent memory stores
# (default: %USERPROFILE%\FullAI_Workspace)
FULLAI_HOME=
# api/desktop_agent.py: separate token gating the desktop automation agent
FULLAI_API_TOKEN=

# --- Tunneling ---------------------------------------------------------------
# docker-compose.yml (ngrok service)
NGROK_AUTHTOKEN=
