# Build-time environment for the frontend Docker image.
#
#   cp .env.docker.example .env.docker   then fill in the values
#   docker compose build --no-cache frontend
#
# WHY THIS FILE IS NEEDED AT ALL
#
# Next.js INLINES every NEXT_PUBLIC_* value into the JavaScript bundle at BUILD
# time. Setting one at `docker compose up` changes nothing for the browser -
# the old value is already baked into the compiled JS. So the frontend image
# must be rebuilt whenever any of these change.
#
# THE RULE THAT FIXES THE DESKTOP AGENT
#
#   NEXT_PUBLIC_BACKEND_URL      -> the CLOUD backend, as the visitor sees it.
#                                   Used by the 13 per-service URLs in
#                                   src/lib/api.ts.
#   NEXT_PUBLIC_API_URL          -> THE USER'S OWN MACHINE (127.0.0.1:8000).
#                                   Read by hub/sara-auto and hub/backend-architect,
#                                   which invoke desktop actions.
#   NEXT_PUBLIC_ULTRON_API_URL   -> same machine.
#   NEXT_PUBLIC_DESKTOP_API_URL  -> same machine.
#   NEXT_PUBLIC_DESKTOP_WS_URL   -> ws://127.0.0.1:8000/ws (note: ws://).
#
# Pointing the desktop vars at a cloud host is precisely what broke the last
# deployment: the cloud Linux container has no pyautogui and no screen, so the
# call executed there and "JARVIS lost its powers". The cloud half plans; the
# local half executes.

# --- Backend the BROWSER can reach ------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# --- The user's OWN machine (desktop control) --------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ULTRON_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DESKTOP_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DESKTOP_WS_URL=ws://127.0.0.1:8000/ws

# --- Auth --------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Shared API key ----------------------------------------------------------
# Must match SARA_API_KEY in backend/.env byte-for-byte.
NEXT_PUBLIC_SARA_API_KEY=
NEXT_PUBLIC_DESKTOP_API_TOKEN=