# frontend environment template (Next.js)
#
# Copy to frontend/.env.local (gitignored) and fill in. Variables prefixed
# NEXT_PUBLIC_ are inlined into the client bundle - never put real secrets in
# them. Empty values below mean "use the code default".

# --- Backend connection ------------------------------------------------------
# src/lib/api.ts: base URL of the unified backend (default http://127.0.0.1:8000)
NEXT_PUBLIC_BACKEND_URL=
# Per-service overrides, all default to NEXT_PUBLIC_BACKEND_URL (api.ts:17-45):
NEXT_PUBLIC_SARA_API_URL=
NEXT_PUBLIC_LEGACY_API_URL=
NEXT_PUBLIC_DESKTOP_API_URL=
NEXT_PUBLIC_DESKTOP_WS_URL=
NEXT_PUBLIC_WHATSAPP_API_URL=
NEXT_PUBLIC_SOCIAL_API_URL=
NEXT_PUBLIC_GAMEFORGE_API_URL=
NEXT_PUBLIC_MUSIC_API_URL=
NEXT_PUBLIC_SCRAPING_API_URL=
NEXT_PUBLIC_VOICE_AGENT_API_URL=
NEXT_PUBLIC_EDULEARNER_API_URL=
NEXT_PUBLIC_ULTRON_API_URL=
# src/lib/api.ts: keys sent with saraFetch / desktop WS connections
NEXT_PUBLIC_SARA_API_KEY=
NEXT_PUBLIC_DESKTOP_API_TOKEN=

# --- Server-side proxies (app/api/chat/route.ts, app/api/orchestrate/route.ts)
SARA_LEGACY_BACKEND_URL=

# --- Off-contract direct callers (hub/backend-architect, hub/sara-auto pages)
NEXT_PUBLIC_API_URL=

# --- Auth (Clerk) - required, the app will not render without these ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Gmail OAuth (src/app/workspace/layout.tsx redirect builder) -------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
